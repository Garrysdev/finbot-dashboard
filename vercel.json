{
  "version": 2,
  "name": "finbot-dashboard",
  "routes": [
    {
      "src": "/data.json",
      "dest": "/data.json"
    },
    {
      "src": "/live_telemetry.json",
      "dest": "/live_telemetry.json"
    },
    {
      "src": "/sports_telemetry.json",
      "dest": "/sports_telemetry.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}